# Select VLM: set COMPOSE_PROFILES to one of: vila, gemma, llava
COMPOSE_PROFILES=gemma

# HuggingFace token (required for gated models like Gemma)
HUGGINGFACE_TOKEN=

# Model overrides (optional)
# GEMMA_MODEL_ID=google/gemma-3-4b-it
# LLAVA_MODEL_PATH=liuhaotian/llava-v1.5-7b
# VILA_MODEL_PATH=Efficient-Large-Model/VILA1.5-3b

# Container image tags (auto-resolved by setup.sh, override if needed)
# OPEN_WEBUI_IMAGE=dustynv/open-webui:r36.4.7-cu126-22.04
# SPEACHES_IMAGE=dustynv/speaches:r36.4.7-cu126-22.04
# KOKORO_TTS_IMAGE=dustynv/kokoro-tts:fastapi-r36.4.7-cu126-22.04
